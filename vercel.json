{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/webp-converter/",
      "destination": "/image-compressor/",
      "permanent": true
    },
    {
      "source": "/fire-calculator/",
      "destination": "/compound-interest-calculator/",
      "permanent": true
    },
    {
      "source": "/pdf-merger/",
      "destination": "/pdf-merge/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|webp|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
